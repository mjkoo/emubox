#!/usr/bin/env bash
# Refuse unresolved install placeholders. Backup credentials are optional when
# off-site backups are disabled, so only those three placeholders are exempt
# in that mode; every other unresolved value remains an installation error.
set -euo pipefail

if [ "$#" -ne 1 ] || { [ "$1" != true ] && [ "$1" != false ]; }; then
  echo "usage: emubox-install-placeholder-guard <true|false>" >&2
  exit 2
fi

awk -F: -v backups="$1" '
  backups == "false" && ($1 == "b2_key_id" || $1 == "b2_application_key" || $1 == "restic_password") { next }
  index($0, "REPLACE-BEFORE-INSTALL") {
    print "unresolved secret: " $1 > "/dev/stderr"
    unresolved = 1
  }
  END { exit unresolved ? 1 : 0 }
'
